{
  "manifest_version": 3,
  "name": "Galactic Library",
  "version": "0.1.0",
  "description": "A private, browser-local index of digital media you own.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.steampowered.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Galactic Library",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["src/providers/steam-store.js", "src/providers/steam-store-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.gog.com/*"],
      "js": ["src/providers/gog.js", "src/providers/gog-content.js"],
      "run_at": "document_idle"
    }
  ]
}
