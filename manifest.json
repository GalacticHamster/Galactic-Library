{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Galactic Library",
  "version": "0.1.0",
  "description": "A private, browser-local index of digital media you own.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "https://openlibrary.org/*",
    "https://www.googleapis.com/*",
    "https://www.fanatical.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Galactic Library",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {"matches": ["https://play.xbox.com/library*"],"js": ["src/providers/provider-snapshot.js","src/providers/xbox-library.js","src/providers/xbox-capture.js"],"world": "MAIN","run_at": "document_start"},
    {"matches": ["https://play.xbox.com/library*"],"js": ["shared/theme.js","src/providers/floating-panel.js","src/providers/xbox-content.js"],"run_at": "document_idle","css": ["shared/theme.css"]},
    {
      "matches": [
        "https://library.playstation.com/*"
      ],
      "js": [
        "src/providers/provider-snapshot.js",
        "src/providers/console-library.js",
        "src/providers/playstation-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://library.playstation.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/playstation-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": ["https://accounts.nintendo.com/portal/vgcs*"],
      "js": ["src/providers/provider-snapshot.js", "src/providers/console-library.js", "src/providers/nintendo-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://accounts.nintendo.com/portal/vgcs*"],
      "js": ["shared/theme.js", "src/providers/floating-panel.js", "src/providers/nintendo-content.js"],
      "run_at": "document_idle",
      "css": ["shared/theme.css"]
    },
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/lib/contents-performance.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/steam-store.js",
        "src/providers/steam-store-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.gog.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/gog.js",
        "src/providers/gog-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://store.epicgames.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/lib/contents-performance.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/epic.js",
        "src/providers/epic-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.audible.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/audible.js",
        "src/providers/audible-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://gaming.amazon.com/*",
        "https://luna.amazon.com/claims/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/amazon-games.js",
        "src/providers/amazon-games-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/lib/contents-performance.js",
        "src/lib/kindle-contents-scan.js",
        "src/providers/kindle-ownership.js",
        "src/providers/kindle.js",
        "src/providers/kindle-content.js",
        "src/providers/amazon-video.js",
        "src/providers/amazon-video-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.kobo.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/lib/contents-performance.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/kobo-ownership.js",
        "src/providers/kobo.js",
        "src/providers/kobo-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://athome.fandango.com/*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/fandango-at-home.js",
        "src/providers/fandango-at-home-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.humblebundle.com/home/purchases*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/humble.js",
        "src/providers/humble-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    },
    {
      "matches": [
        "https://www.fanatical.com/orders*",
        "https://www.fanatical.com/*/orders*"
      ],
      "js": [
        "shared/theme.js",
        "src/providers/floating-panel.js",
        "src/providers/provider-snapshot.js",
        "src/providers/metadata.js",
        "src/providers/fanatical.js",
        "src/providers/fanatical-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "shared/theme.css"
      ]
    }
  ],
  "optional_permissions": [
    "notifications"
  ]
}
