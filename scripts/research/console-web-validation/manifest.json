{
  "manifest_version": 3,
  "name": "GL Console Library Validation (read only)",
  "version": "0.1.1",
  "description": "Observe aggregate library request diagnostics. Does not import or save library data.",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {"gecko": {"id": "console-validation@galactic-library.invalid", "strict_min_version": "128.0"}},
  "content_scripts": [
    {
      "matches": ["https://library.playstation.com/*", "https://accounts.nintendo.com/portal/vgcs*"],
      "js": ["core.js", "probe.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://library.playstation.com/*", "https://accounts.nintendo.com/portal/vgcs*"],
      "js": ["core.js", "panel.js"],
      "run_at": "document_idle"
    }
  ]
}
