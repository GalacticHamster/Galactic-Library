{
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "scripts": [
      "src/background/service-worker.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "galactic-library@galactichamster.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  }
}
